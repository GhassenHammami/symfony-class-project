{% extends 'base.html.twig' %}

{% block body %}

    {# Affichage d'une erreur éventuelle #}
    {% if error %}
        <div style="color: red; margin-bottom: 10px;">
            {{ error.messageKey|trans(error.messageData, 'security') }}
        </div>
    {% endif %}

    <h1>Connexion</h1>

    <form action="{{ path('app_login') }}" method="post">

        <label for="username">Email :</label>
        <input type="text" id="username" name="_username" value="{{ email }}">

        <br><br>

        <label for="password">Password :</label>
        <input type="password" id="password" name="_password">

        {# Si vous voulez rediriger vers une page spécifique après connexion :
        <input type="hidden" name="_target_path" value="/account">
        #}

        <br><br>

        <button type="submit">Login</button>
        <a href="{{ path('app_register') }}" class="btn btn-secondary">Register</a>
    </form>

{% endblock %}
