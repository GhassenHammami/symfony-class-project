{% extends 'base.html.twig' %}

{% block title %}Liste des Offres d'Emploi{% endblock %}

{% block body %}
<h2>Liste des Offres d'Emploi</h2>
<a href="{{ path('app_job_new') }}" class="btn btn-primary">Create new job</a>
<a href="{{ path('app_image_new') }}" class="btn btn-secondary">Create image</a>
<table class="table table-hover table-striped" border="1">
    <thead>
        <tr>
            <th>#</th>
            <th>Titre</th>
            <th>Description</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        {% for job in jobs %}
        <tr>
            <td>{{ job.id }}</td>
            <td>{{ job.type }}</td>
            <td>{{ job.description }}</td>
            <td>
                <a class="btn btn-info btn-sm" href="{{ path('app_job_show', {'id': job.id}) }}">Voir</a>
            </td>
        </tr>
        {% else %}
        <tr><td colspan="4">Aucune offre d'emploi trouvée.</td></tr>
        {% endfor %}
    </tbody>
</table>
<a href="{{ path('home') }}" class="btn btn-secondary">Retour à l'accueil</a>
{% endblock %}
