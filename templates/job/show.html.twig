{% extends "base.html.twig" %}
{% block title %}{{ parent() }} - Edit{% endblock %}
{% block titre %}{{ parent()|upper }} Consultation du job {{ job.getType() }}{% endblock %}
{% block body %}
    <h1>Entreprise : {{ job.company }} </h1> <br>
    <h1>Description : {{ job.description }} </h1>
    <h2>Date d'expiration : {{ job.getExpiresAt() | date('d-m-Y') }}</h2>
    {% if job.image is not null %}
        <h3>Image :</h3>
        <img src="{{ job.image.getUrl() }}" alt="{{ job.image.getAlt() }}" height="100">
    {% endif %}

    <h2>{{ job.company }}</h2>
    <p>{{ job.description }}</p>
    <h3>Candidatures</h3>
    <ul>
        {% for candidature in listCandidatures %}
            <li>{{ candidature.candidat }}</li>
        {% else %}
            <li>No candidatures yet.</li>
        {% endfor %}
    </ul>

    {% if listCandidatures is not empty %}
    <h3>Liste des candidatures :</h3>
        <ul>
            {% for candidature in listCandidatures %}
            <h4>Candidat</h4>
            <ul type="square">
                <li><strong>Nom :</strong> {{ candidature.candidat }}</li>
                <li><strong>Contenu :</strong> {{ candidature.contenu }}</li>
                <li><strong>Date :</strong> {{ candidature.date|date('d-m-Y') }}</li>
            </ul>
            <hr>
            {% endfor %}
        </ul>
    {% endif %}

    <a href="{{ path('home') }}" class="btn btn-secondary">Back to Home</a>
    <a href="{{ path('app_job_new') }}" class="btn btn-primary">Create New Job</a>

{% endblock %}
