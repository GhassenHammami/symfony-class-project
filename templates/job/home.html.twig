{% extends 'base.html.twig' %}

{% block body %}
<h2>Liste des Candidats | <small><a href="{{path('app_candidature_new')}}">Ajouter</a></small></h2>

{% for msg in app.flashes('notice') %}
    {{ msg }}
{% endfor %}

<table class="table table-hover table-striped" border="1">
    <thead>
        <tr>
            <th>#</th>
            <th>Nom & Prénom</th>
            <th>Date</th>
            <th>Contenu</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        {% for candidat in lesCandidats %}
        <tr>
            <td>{{ candidat.id }}</td>
            <td>{{ candidat.candidat | upper }}</td>
            <td>{{ candidat.date | date('d/m/y') }}</td>
            <td>{{ candidat.contenu }}</td>
            <td>
                <a class="btn btn-primary" href="#">voir</a>
                <a class="btn btn-warning"
                    href="{{ path('app_candidature_edit', {'id': candidat.id}) }}">
                    Modifier
                </a>
                <a class="btn btn-danger"href="{{ path('app_candidature_delete', {'id': candidat.id}) }}"
                    onclick="return confirm('Are you sure to delete {{ candidat.id }} ?')">
                    Supprimer
                </a>
            </td>
        </tr>
        {% else %}
        <tr>
            <td colspan="5">Aucun candidat trouvé.</td>
        </tr>
        {% endfor %}
    </tbody>
</table>

<a href="{{ path('app_job_index') }}" class="btn btn-info">View All Jobs</a>

{% endblock %}
