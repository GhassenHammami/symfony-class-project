{% extends 'base.html.twig' %}

{% block title %}Edit Image{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1 class="mb-4">Edit Image</h1>

    <div class="row">
        <div class="col-md-6">
            {{ include('image/_form.html.twig', {'button_label': 'Update'}) }}
        </div>

        <div class="col-md-6">
            {% if image.url %}
                <h5>Current Image</h5>
                <div class="border p-2 mb-3">
                    <img src="{{ image.url }}" 
                         alt="{{ image.alt }}" 
                         class="img-fluid rounded"
                         style="max-height: 500px; width: auto;">
                </div>
            {% else %}
                <p>No image uploaded yet.</p>
            {% endif %}
        </div>
    </div>

    <div class="mt-3 d-flex justify-content-between">
        <a href="{{ path('app_image_index') }}" class="btn btn-secondary">Back to list</a>
        {{ include('image/_delete_form.html.twig') }}
    </div>
</div>
{% endblock %}
